# Скопируйте в .env. Внесены параметры владельца A1 mini и PLA.
# Ресурс, обслуживание и упаковка пока являются предварительными нормативами.
DB_PASSWORD=replace-with-local-database-password
DB_URL=jdbc:postgresql://localhost:5434/printlab
DB_USER=printlab
# Порт БД только на localhost; в Docker бот обращается к db:5432.
POSTGRES_PORT=5434
BOT_MEMORY_LIMIT=1g
BOT_CPUS=1.0
BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Числовые Telegram IDs операторов. В таблице customers используются UUID.
TELEGRAM_ADMIN_IDS=
TELEGRAM_ADMIN_USERNAMES=oilbanana,muslimitsuhide
BUSINESS_CONTACT="@oilbanana, @muslimitsuhide"
TERMS_URL=
PRIVACY_URL=
PAYMENT_INSTRUCTIONS='Укажите свой способ оплаты и получения заказа'

PRICING_CONFIRMED=false
TARIFF_VERSION=a1-mini-v6
MATERIAL_SALE_MULTIPLIER=10
PLA_BLACK_PER_KG=1000.00
PLA_BLACK_LABEL='PLA (цвет уточняется)'
PLA_BLACK_AVAILABLE=true
PLA_WHITE_PER_KG=1000.00
PLA_WHITE_AVAILABLE=false
PETG_BLACK_PER_KG=900.00
PETG_BLACK_AVAILABLE=false
ELECTRICITY_PER_KWH=13.00
PRINTER_KW=0.15
PRINTER_PURCHASE_COST=20000.00
# Предварительный ресурс, не измерение: 2000 ч даёт амортизацию 10 ₽/ч.
PRINTER_LIFETIME_HOURS=2000
# Резервная ставка для старых тарифов; при цене/ресурсе повторно не прибавляется.
DEPRECIATION_PER_HOUR=0.00
MAINTENANCE_PER_HOUR=5.00
# Стоимость времени владельца не учитывается по его запросу.
LABOR_PER_HOUR=0.00
PACKAGING=35.00
ACQUISITION_PER_NEW_CUSTOMER=0.00
FAILURE_PROBABILITY=0.10
LAUNCH_FEE=0.00
# Отдельный сбор за запуск отключён. Исторические снимки сохраняют прежний тариф.
LAUNCH_FEE_PER_ORDER=true
DISCOUNT_LAUNCH_FEE=false
# Доли, а не проценты: 0.03 означает 3%. Укажите свои ставки.
PAYMENT_RATE=0.03
PAYMENT_FIXED=0.00
TAX_RATE=0.04
# 0.50 = 50% дохода печати к затратам.
TARGET_PROFIT_MARKUP=0.50
MINIMUM_PROFIT_MARKUP=0.50
MINIMUM_PRINT_PRICE=0.00
# Дополнительный порог в рублях выключен: действует минимум 50% к затратам.
MINIMUM_CONTRIBUTION=0.00

PROMO_ENABLED=false
PROMO_MAX_DISCOUNT=
PROMO_MAX_PAID_ORDERS=2
PROMO_SECOND_MAX_PAID_ORDERS=8
PROMO_BUDGET=
PROMO_ENDS_AT=2026-12-31T20:59:59Z

# HTTP — существующий backend с Bambu Studio; CLI — локальный бинарник.
NOZZLE_DIAMETER_MM=0.4
SLICER_ENGINE=BAMBU_STUDIO
SLICER_ENABLED=false
SLICER_PROFILE_CONFIRMED=false
SLICER_EXECUTABLE=bambu-studio
SLICER_VERSION=unconfigured
SLICER_PROFILES_DIR=./config/slicer/a1-mini
SLICER_WORK_DIR=./data/slicing
MODEL_STORAGE_DIR=./data/models

SLICER_TRANSPORT=HTTP
SLICER_BACKEND_URL=http://127.0.0.1:8080/api/print-plans/analyze-stl
SLICER_BACKEND_PLA=prusament-pla
SLICER_BACKEND_PETG=prusament-petg
SLICER_TIMEOUT_SECONDS=210
